# Copie este arquivo para .env e nunca versione os valores reais.
# Dashboard > Project Settings > General > Reference ID.
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst

# Dashboard > Connect > Session pooler. Copie a URL inteira, substitua a senha,
# percent-encode caracteres reservados e mantenha sslmode=require.
CONTAI_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
