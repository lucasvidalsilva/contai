{"marker":null,"marker_kind":"text","source_block_index":0,"source_class":null,"source_tag":"p","text":"Veja também:"}
{"marker":null,"marker_kind":"text","source_block_index":1,"source_class":"ementa","source_tag":"p","text":"Institui o Imposto sobre Bens e Serviços (IBS), a Contribuição Social sobre Bens e Serviços (CBS) e o Imposto Seletivo (IS); cria o Comitê Gestor do IBS e altera a legislação tributária."}
{"marker":null,"marker_kind":"text","source_block_index":2,"source_class":null,"source_tag":"p","text":"Brasília, 1º de julho de 2025; 204º da Independência e 137º da República."}
{"marker":null,"marker_kind":"text","source_block_index":3,"source_class":null,"source_tag":"p","text":"LUIZ INÁCIO LULA DA SILVA"}
{"marker":null,"marker_kind":"text","source_block_index":4,"source_class":null,"source_tag":"p","text":"57ª Legislatura - 4ª Sessão Legislativa Ordinária"}
{"marker":null,"marker_kind":"text","source_block_index":5,"source_class":null,"source_tag":"p","text":"Por favor, aguarde."}
