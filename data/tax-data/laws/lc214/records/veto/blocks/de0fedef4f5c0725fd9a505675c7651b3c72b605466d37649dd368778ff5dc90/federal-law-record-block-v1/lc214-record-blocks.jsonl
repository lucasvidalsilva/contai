{"marker":null,"marker_kind":"text","source_block_index":52,"source_class":"MsoNormal","source_tag":"p","text":"1.8"}
{"marker":null,"marker_kind":"text","source_block_index":54,"source_class":"MsoNormal","source_tag":"p","text":"Seguro para casos de dispositivos com dados pessoais, furtados ou roubados"}
{"marker":null,"marker_kind":"text","source_block_index":56,"source_class":"MsoNormal","source_tag":"p","text":"pendente de classificação"}
{"marker":null,"marker_kind":"text","source_block_index":58,"source_class":"MsoNormal","source_tag":"p","text":"1.9"}
{"marker":null,"marker_kind":"text","source_block_index":60,"source_class":"MsoNormal","source_tag":"p","text":"Serviço de proteção e ressarcimento de transações"}
{"marker":null,"marker_kind":"text","source_block_index":61,"source_class":"MsoNormal","source_tag":"p","text":"bancárias indevidas, motivadas por furto, roubo ou"}
