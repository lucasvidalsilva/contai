{"marker":null,"marker_kind":"text","source_block_index":75,"source_class":null,"source_tag":"p","text":"57ª Legislatura - 4ª Sessão Legislativa Ordinária"}
{"marker":null,"marker_kind":"text","source_block_index":76,"source_class":null,"source_tag":"p","text":"Por favor, aguarde."}
