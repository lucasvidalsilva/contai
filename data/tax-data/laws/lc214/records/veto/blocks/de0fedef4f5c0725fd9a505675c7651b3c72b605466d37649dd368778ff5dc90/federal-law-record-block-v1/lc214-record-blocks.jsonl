{"marker":null,"marker_kind":"text","source_block_index":44,"source_class":"MsoNormal","source_tag":"p","text":"1.1802.30.00"}
{"marker":null,"marker_kind":"text","source_block_index":46,"source_class":"MsoNormal","source_tag":"p","text":"....."}
